{
  "name": "dsh-pintop",
  "version": "0.1.1",
  "description": "Native Windows always-on-top sidebar control for DeepSeek Harness",
  "type": "module",
  "main": "./lib/host.js",
  "exports": { ".": "./lib/host.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "native", "cordis.patch.yml", "README.md", "README.en.md"],
  "scripts": { "test": "node --test test/*.test.mjs", "test:native": "node test/native.mjs" },
  "dsh": {
    "engines": { "dsh": ">=0.2.0-rc.2" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-slots"], "platform": "web" }
  },
  "license": "MIT"
}
